  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/timer", "destination": "/admin/timer", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
